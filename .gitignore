# ====================
# BACKEND (Django / Python)
# ====================

# Ambientes virtuais em qualquer pasta do repositório (evita milhares de arquivos no commit)
**/.venv/
**/venv/
**/.virtualenv/

# Python cache / compilados
back-end-selecao/*.py[cod]
back-end-selecao/*$py.class
**/__pycache__/
*.py[cod]
*$py.class

# Environments nomeados (legado / deploy local no backend)
back-end-selecao/env/
back-end-selecao/ENV/

# Django stuff
back-end-selecao/*.log
back-end-selecao/db.sqlite3
back-end-selecao/test_db.sqlite3
back-end-selecao/media/
back-end-selecao/static/

# Testing
back-end-selecao/.tox/
back-end-selecao/.pytest_cache/
back-end-selecao/coverage.xml
back-end-selecao/htmlcov/

# Mypy / Pyre
back-end-selecao/.mypy_cache/
back-end-selecao/.dmypy.json
back-end-selecao/.pyre/

# IDEs
back-end-selecao/.vscode/
back-end-selecao/.idea/

# Env files
back-end-selecao/.env
!back-end-selecao/.env.exemple

# Other
back-end-selecao/*.pot
back-end-selecao/*.mo
back-end-selecao/staticfiles/

# Coverage local
.coverage
**/.coverage


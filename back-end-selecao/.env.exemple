# General config
# Copie para `.env` e preencha. NUNCA commit secrets reais.
SYSTEM_NAME=Selecao Simplificada
DEBUG=False
SECRET_KEY=CHANGE_ME_GENERATE_A_STRONG_SECRET
# Somado aos hosts fixos no settings.py. Inclua o IP do servidor se acessar por IP (ex.: app.example.com).
ALLOWED_HOSTS=example.com,example.com,localhost,localhost,127.0.0.1
# CORS + CSRF: URLs completas ao usar IP (frontend :3002, API :8012 ou proxy). Separadas por vírgula.
EXTRA_ORIGINS=
HOST_BASE_URL=localhost

# Configuração das portas do app
APP_CONTAINER_NAME=selecao_system
APP_EXTERNAL_PORT=8000
APP_INTERNAL_PORT=8000
NGINX_EXTERNAL_PORT=8010
NGINX_INTERNAL_PORT=8080

# Database config - PostgreSQL
POSTGRES_DB=selecao_db
POSTGRES_USER=selecao_user
POSTGRES_PASSWORD=CHANGE_ME
DB_NAME=selecao_db
DB_USER=selecao_user
DB_PASSWORD=CHANGE_ME
DB_HOST=db_postgres
# Dentro do Docker Compose use db_postgres (nome do serviço). Fora do container use localhost/IP.
DB_PORT=5432
DATABASE_EXTERNAL_PORT=15436

# Database GUI - PgAdmin
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME
PGADMIN_EXTERNAL_PORT=8091

# Configurações de Email - Gmail (use app password; não versionar o valor real)
EMAIL_HOST=smtp.gmail.com
EMAIL_HOST_USER=CHANGE_ME@example.com
EMAIL_HOST_PASSWORD=CHANGE_ME
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_USE_SSL=False
DEFAULT_FROM_EMAIL=CHANGE_ME@example.com

# Redis: cache, OTP e result backend. Broker Celery = RabbitMQ.
# CACHE_URL: alias na rede selecao_global (redis_<APP_CONTAINER_NAME>).
CACHE_URL=redis://redis_selecao_system:6379/1
RABBITMQ_USER=selecao
RABBITMQ_PASSWORD=CHANGE_ME
CELERY_BROKER_URL=amqp://selecao:CHANGE_ME@rabbitmq:5672//
CELERY_RESULT_BACKEND=redis://redis:6379/0

# SMS — recuperação de senha por OTP (iSend SOAP + Redis)
# SMS_PROVIDER=console (dev) | isend (produção)
SMS_PROVIDER=console
SMS_DEBUG_EXPOSE_ERRORS=false
# Token estático (opcional) OU credenciais do painel (senha em texto puro, não MD5):
ISEND_TOKEN=
# ISEND_PASSWORD: mesma senha do login em app.isend.com.br (texto puro)
ISEND_USERNAME=
ISEND_PASSWORD=
ISEND_WSDL=http://www2.isend.com.br/SendWSImplService/SendWSImpl?wsdl
ISEND_AUTH_WSDL=http://www2.isend.com.br/iSend/ws/PartnerSendIntegrationWs?wsdl
ISEND_TOKEN_TTL=43200
SMS_VERIFICATION_TTL=300
SMS_VERIFICATION_LENGTH=6
SMS_VERIFICATION_MAX_ATTEMPTS=5
SMS_VERIFICATION_RESEND_COOLDOWN=60
